# Salin file ini menjadi ".env" (di folder yang sama), lalu isi NEO4J_PASSWORD.
#
# Koneksi HARUS ke DBMS lokal di Neo4j Desktop (host localhost / 127.0.0.1).
# Script menolak URI non-lokal, jadi AuraDB / cloud tidak akan pernah terpakai.
#
# Port 7687 adalah default Neo4j Desktop. Kalau Anda punya beberapa DBMS lokal,
# port-nya bisa berbeda (cek di detail DBMS pada Neo4j Desktop).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=isi_dengan_password_dbms_anda

# OPSIONAL - hanya untuk tombol "nyalakan Neo4j" di kedua notebook di folder notebooks/, dan hanya kalau Anda memakai
# Neo4j Community hasil ekstrak zip (bukan Neo4j Desktop). Isi dengan folder Neo4j-nya, mis.:
# NEO4J_HOME=D:\Softwares\neo4j-community-5.26.31
